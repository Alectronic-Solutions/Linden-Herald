{
  "name": "linden-herald",
  "version": "1.0.0",
  "private": true,
  "description": "The Linden Herald - weekly newspaper serving San Joaquin County since 1959",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "validate": "tsx scripts/validate-data.ts",
    "validate:fix": "tsx scripts/validate-data.ts --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm run validate",
    "build:ghpages": "cross-env NEXT_PUBLIC_BASE_PATH=/Linden-Herald npm run build",
    "prebuild": "npm run validate",
    "budget": "node scripts/check-budget.mjs",
    "issues:json": "tsx scripts/validate-data.ts --json"
  },
  "dependencies": {
    "next": "16.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^20.14.15",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.0",
    "eslint-config-next": "16.3.4",
    "postcss": "^8.4.45",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.4.10",
    "tsx": "^4.23.13",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=20"
  }
}
